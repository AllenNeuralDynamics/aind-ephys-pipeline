FROM python:3.13-slim

ARG DEBIAN_FRONTEND=noninteractive

# 1. Install system dependencies as root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        procps \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Python packages as root so they land in the system (conda) site-packages,
#    accessible to any user regardless of UID at runtime.
# TODO: add back neuroconv once it is released on PyPI
COPY package-versions.txt /tmp/package-versions.txt
RUN pip install --upgrade pip && \
    grep -E 'log-schema|aind-data-schema|aind-nwb-utils|zarr|numcodecs|hdmf-zarr|pynwb|pytz|wavpack-numcodecs|neo' /tmp/package-versions.txt | xargs pip install

RUN SPIKEINTERFACE_VERSION=$(grep '^spikeinterface==' /tmp/package-versions.txt | cut -d'=' -f3) && \
    pip install "spikeinterface[full]==${SPIKEINTERFACE_VERSION}"

# TODO: remove once neuroconv is released
RUN pip install --force-reinstall --no-deps "neuroconv @ git+https://github.com/catalystneuro/neuroconv.git@zarrv3";

# 3. Redirect numba's JIT cache to a writable location (see Dockerfile_base for context).
ENV NUMBA_CACHE_DIR=/tmp/numba_cache

# 4. Create non-root user for runtime, with home dir writable by any UID
#    (see Dockerfile_base for context).
RUN useradd -m -u 1000 pipelineuser && chmod 777 /home/pipelineuser
ENV HOME=/home/pipelineuser

# 5. Setup work area
WORKDIR /home/pipelineuser

# 6. Switch to non-root user
USER pipelineuser
