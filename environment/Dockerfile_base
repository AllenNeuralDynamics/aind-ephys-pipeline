FROM python:3.13-slim

ARG DEBIAN_FRONTEND=noninteractive

# 1. Install system dependencies as root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        fonts-freefont-ttf \
        libvips-dev \
        libtiff-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Python packages as root so they land in the system (conda) site-packages,
#    accessible to any user regardless of UID at runtime.
COPY package-versions.txt /tmp/package-versions.txt
# CPU-only torch: no process in this image uses the GPU (saves ~4GB of CUDA libraries).
# Installed first so that later installs don't pull in the CUDA build.
RUN pip install --upgrade pip && \
    grep -E '^torch==' /tmp/package-versions.txt | xargs pip install --index-url https://download.pytorch.org/whl/cpu

# pyvips 2.2.1 builds a cffi extension that gcc 14 (trixie) rejects as an error; downgrade to a warning.
ENV CFLAGS=-Wno-error=incompatible-pointer-types
RUN grep -E 'log-schema|aind-data-schema|aind-metadata-upgrader|aind-qcportal-schema|zarr|numcodecs|pyvips|sortingview|figpack|figpack-spike-sorting|matplotlib_venn|wavpack-numcodecs|pynwb|hdmf-zarr|hdbscan|s3fs|seaborn|scikit-learn|neo|scipy' \
        /tmp/package-versions.txt | xargs pip install

RUN SPIKEINTERFACE_VERSION=$(grep '^spikeinterface==' /tmp/package-versions.txt | cut -d'=' -f3) && \
    pip install "spikeinterface[full,widgets]==${SPIKEINTERFACE_VERSION}"

# 3. Redirect cache dirs to a writable location (numba, matplotlib, huggingface).
#    Numba defaults to caching next to the .py source files, which live in the
#    root-owned conda site-packages and are not writable when the container is
#    run with --user $(id -u):$(id -g) (UID != 1000).
ENV NUMBA_CACHE_DIR=/tmp/numba_cache
ENV MPLCONFIGDIR=/tmp/matplotlib_cache
ENV HF_HOME=/tmp/huggingface_cache

# 4. Create non-root user for runtime, with home dir writable by any UID.
#    This lets tools that write to ~/.something (kachery, huggingface tokens,
#    pip caches, etc.) work even when the container is launched with
#    --user $(id -u):$(id -g) where the host UID isn't in /etc/passwd and
#    HOME would otherwise fall back to '/'.
RUN useradd -m -u 1000 pipelineuser && chmod 777 /home/pipelineuser
ENV HOME=/home/pipelineuser

# 5. Setup work area
WORKDIR /home/pipelineuser

# 6. Switch to non-root user
USER pipelineuser
