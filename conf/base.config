/*
 * Compute resources -- included by nextflow.config
 *
 *   label         time        GPU   used by
 *   process_cpu   12 h  x n   no    job dispatch, preprocessing, spykingcircus2, lupin, postprocessing,
 *                                   curation, visualization, results/QC collectors, QC, NWB, provenance
 *   process_gpu   24 h  x n   1     kilosort25, kilosort4, dartsort
 *
 *   cpus and memory are sized per step (below, from the previous production settings);
 *   memory and time grow with the attempt number n.
 *
 * GPU isolation: only process_gpu tasks get --gpus (docker) / --nv (apptainer, singularity),
 * accelerator = 1 and a host-side nvidia-smi check that stops the task when no GPU
 * is visible -- no silent CPU fallback. process_cpu tasks start without GPU access.
 *
 * Retries: exit codes 130-145 (killed: out of memory / time), 104 and 175 are retried twice with
 * more memory and time; anything else lets running tasks finish and stops the pipeline.
 * No request ever exceeds --max_cpus / --max_memory / --max_time.
 */

process {

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    withLabel: 'process_cpu' {
        time = { 12.h * task.attempt }
    }

    withLabel: 'process_gpu' {
        time             = { 24.h * task.attempt }
        accelerator      = 1
        // --gpus / --nv for this task only; params.gpu_id pins one device
        containerOptions = {
            workflow.containerEngine == 'docker'
                ? ( params.gpu_id ? "--gpus device=${params.gpu_id}" : '--gpus all' )
                : ( params.gpu_id ? "--nv --env CUDA_VISIBLE_DEVICES=${params.gpu_id}" : '--nv' )
        }
        // runs on the host before the container starts: refuse to run a GPU task without a GPU
        beforeScript     = {
            def device = params.gpu_id ? "-i ${params.gpu_id} " : ''
            "nvidia-smi ${device}-L > /dev/null 2>&1 || { echo \"ERROR: ${task.process} needs an NVIDIA GPU${params.gpu_id ? ' (gpu_id ' + params.gpu_id + ')' : ''} but none is visible on \$(hostname)\" >&2; exit 1; }"
        }
    }

    // ---- per-step size (cpus fixed, memory x attempt) ----
    withName: 'EPHYS_PROVENANCE'         { cpus = 1;  memory = { 2.GB  * task.attempt } }
    withName: 'EPHYS_JOBDISPATCH'        { cpus = 4;  memory = { 32.GB * task.attempt } }
    withName: 'EPHYS_PREPROCESSING'      { cpus = 16; memory = { 64.GB * task.attempt } }
    withName: 'KILOSORT4_SPIKESORT'      { cpus = 16; memory = { 60.GB * task.attempt } }
    withName: 'KILOSORT25_SPIKESORT'     { cpus = 16; memory = { 60.GB * task.attempt } }
    withName: 'DARTSORT_SPIKESORT'       { cpus = 16; memory = { 60.GB * task.attempt } }
    withName: 'SPYKINGCIRCUS2_SPIKESORT' { cpus = 16; memory = { 64.GB * task.attempt } }
    withName: 'LUPIN_SPIKESORT'          { cpus = 16; memory = { 64.GB * task.attempt } }
    withName: 'EPHYS_POSTPROCESSING'     { cpus = 16; memory = { 64.GB * task.attempt } }
    withName: 'EPHYS_CURATION'           { cpus = 4;  memory = { 32.GB * task.attempt } }
    withName: 'EPHYS_VISUALIZATION'      { cpus = 4;  memory = { 32.GB * task.attempt } }
    withName: 'EPHYS_RESULTSCOLLECTOR'   { cpus = 4;  memory = { 32.GB * task.attempt } }
    withName: 'EPHYS_QUALITYCONTROL'     { cpus = 8;  memory = { 64.GB * task.attempt } }
    withName: 'EPHYS_QCCOLLECTOR'        { cpus = 1;  memory = { 8.GB  * task.attempt } }
    withName: 'NWB_ECEPHYS'              { cpus = 8;  memory = { 64.GB * task.attempt } }
    withName: 'NWB_UNITS'                { cpus = 4;  memory = { 32.GB * task.attempt } }
}
