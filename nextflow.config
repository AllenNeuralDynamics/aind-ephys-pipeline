/*
 * AIND Ephys Pipeline -- the one configuration file
 *
 *   manifest, outputDir, every parameter with its default (described in nextflow_schema.json),
 *   compute resources (conf/base.config), per-process settings, container runtimes, profiles.
 *
 * Run:       nextflow run main.nf -profile <docker|apptainer|singularity> --ecephys_path <session>
 * Override:  --param value, dotted for step parameters (--preprocessing.filter_type bandpass),
 *            -params-file my_params.json (merged over the defaults below), or -c extra.config
 */

manifest {
    name            = 'aind-ephys-pipeline'
    description     = 'Electrophysiology analysis pipeline with SpikeInterface'
    homePage        = 'https://github.com/AllenNeuralDynamics/aind-ephys-pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10'
    version         = '1.5.0'     // the pipeline version; default container tag of every image
}

// Results directory of the whole pipeline: every published output goes here (see the `output {}` block
// in main.nf). Set RESULTS_PATH, or pass -output-dir <dir> on the command line.
outputDir = "${System.getenv('RESULTS_PATH')}"
workflow.output.mode = 'copy'

plugins {
    id 'nf-schema@2.7.3' // validates the step parameters against nextflow_schema.json
}

params {
    // ---- input / output -------------------------------------------------------------------
    // session folder or s3:// URL; falls back to --ecephys_url, then the DATA_PATH environment variable
    ecephys_path = null
    ecephys_url  = null

    // ---- pipeline options -------------------------------------------------------------------
    sorter              = 'kilosort4'     // kilosort25 | kilosort4 | spykingcircus2 | lupin | dartsort
    runmode             = 'full'          // full | fast (no motion correction, LFP or PCs / spike locations)
    // container tag of the ghcr.io/allenneuraldynamics images: CONTAINER_TAG env var, else manifest.version
    container_tag       = System.getenv('CONTAINER_TAG')
    extra_installs      = ''              // extra pip packages (comma-separated) installed before each step
    n_jobs              = null            // N_JOBS for the steps; default: the task's cpus
    pass_pipeline_paths = true            // give DATA_PATH / RESULTS_PATH to the results collector and QC
    // Version of the pipeline the step parameters are compatible with
    pipeline_version    = '1.5.0'

    // ---- step parameter overrides as strings ----------------------------------------------
    // dotted overrides in one string: --extra_params "--preprocessing.filter_type=bandpass ..."
    extra_params                   = null
    // legacy per-step strings: --preprocessing_args "--filter_type bandpass"
    logging_args                   = null
    job_dispatch_args              = null
    preprocessing_args             = null
    spikesorting_args              = null    // applies to the selected sorter
    postprocessing_args            = null
    curation_args                  = null
    visualization_kwargs           = null
    results_collector_args         = null
    nwb_ecephys_args               = null
    nwb_units_args                 = null
    quality_control_args           = null
    quality_control_collector_args = null

    // ---- compute caps used by conf/base.config ----------------------------------------------
    max_cpus   = Runtime.runtime.availableProcessors()
    max_memory = "${java.lang.management.ManagementFactory.operatingSystemMXBean.totalMemorySize.intdiv(1024 * 1024 * 1024)}.GB"
    max_time   = "240.h"
    gpu_id     = null                    // pin GPU tasks to one device (docker / apptainer)

    // ---- step parameters -------------------------------------------------------------------
    // Written to full_params.json and read by every step as params.json.
    // Converted from default_params.json; schema in nextflow_schema.json (step_parameters).
    // a map, not a block: `package` is a Groovy keyword (the v1 parser of Nextflow < 26.04 rejects it as a block key)
    logging = ['package': 'logging', logging_cfg: [level: 'INFO', format: '%(message)s']]
    job_dispatch {
        split_segments        = true
        split_groups          = true
        debug                 = false
        debug_duration        = 30
        skip_timestamps_check = false
        multi_session         = false
        input                 = 'aind'
    }
    preprocessing {
        job_kwargs {
            chunk_duration = '1s'
            progress_bar   = false
            mp_context     = 'spawn'
        }
        filter_type                   = 'highpass'
        remove_out_channels           = true
        remove_bad_channels           = true
        min_preprocessing_duration    = 120
        max_bad_channel_fraction      = 0.5
        denoising_strategy            = 'cmr'
        default_preprocessing_pipeline {
            phase_shift {
                margin_ms = 100.0
            }
            highpass_filter {
                freq_min = 300.0
            }
            bandpass_filter {
                freq_min = 300.0
                freq_max = 6000.0
            }
            detect_and_remove_bad_channels {
                method                    = 'coherence+psd'
                dead_channel_threshold    = -0.5
                noisy_channel_threshold   = 1.0
                outside_channel_threshold = -0.3
                outside_channels_location = 'top'
                n_neighbors               = 11
                channel_filters           = ['noise', 'dead', 'out']
                seed                      = 0
            }
            common_reference {
                reference = 'global'
                operator  = 'median'
            }
            highpass_spatial_filter {
                n_channel_pad         = 60
                n_channel_taper       = null
                direction             = 'y'
                apply_agc             = true
                agc_window_length_s   = 0.01
                highpass_butter_order = 3
                highpass_butter_wn    = 0.01
            }
        }
        custom_preprocessing_pipeline = null
        motion_correction {
            compute                   = true
            apply                     = false
            preset                    = 'dredge_fast'
            detect_kwargs             = [:]
            select_kwargs             = [:]
            localize_peaks_kwargs     = [:]
            estimate_motion_kwargs {
                win_step_norm  = 0.1
                win_scale_norm = 0.1
            }
            interpolate_motion_kwargs = [:]
        }
    }
    postprocessing {
        job_kwargs {
            chunk_duration = '1s'
            progress_bar   = false
        }
        use_motion_corrected = false
        sparsity {
            method    = 'radius'
            radius_um = 100
        }
        duplicate_threshold  = 0.9
        return_in_uV         = true
        extensions {
            random_spikes {
                max_spikes_per_unit = 500
                method              = 'uniform'
                margin_size         = null
                seed                = null
            }
            noise_levels {
                random_slices_kwargs {
                    num_chunks_per_segment = 20
                    chunk_size             = 10000
                    seed                   = null
                }
            }
            waveforms {
                ms_before = 2.0
                ms_after  = 3.0
                dtype     = null
            }
            templates          = [:]
            spike_amplitudes   = [:]
            template_similarity {
                method = 'l1'
            }
            correlograms {
                window_ms = 50.0
                bin_ms    = 1.0
            }
            isi_histograms {
                window_ms = 100.0
                bin_ms    = 5.0
            }
            unit_locations {
                method = 'monopolar_triangulation'
            }
            spike_locations {
                method = 'grid_convolution'
            }
            template_metrics {
                upsampling_factor             = 10
                include_multi_channel_metrics = true
            }
            principal_components {
                n_components = 5
                mode         = 'by_channel_local'
                whiten       = true
            }
            amplitude_scalings = [:]
            valid_unit_periods = [:]
            quality_metrics {
                metric_names = ['num_spikes', 'firing_rate', 'presence_ratio', 'snr', 'isi_violation', 'rp_violation', 'sliding_rp_violation', 'amplitude_cutoff', 'amplitude_median', 'amplitude_cv', 'noise_cutoff', 'synchrony', 'firing_range', 'drift', 'sd_ratio', 'mahalanobis', 'd_prime', 'nearest_neighbor', 'silhouette']
                metric_params {
                    presence_ratio {
                        bin_duration_s = 60
                    }
                    snr {
                        method = 'extremum'
                    }
                    isi_violation {
                        isi_threshold_ms = 1.5
                        min_isi_ms       = 0
                    }
                    rp_violation {
                        refractory_period_ms = 1
                        censored_period_ms   = 0.0
                    }
                    sliding_rp_violation {
                        bin_size_ms                 = 0.25
                        window_size_s               = 1
                        exclude_ref_period_below_ms = 0.5
                        max_ref_period_ms           = 10
                        contamination_values        = null
                    }
                    amplitude_cutoff {
                        num_histogram_bins        = 100
                        histogram_smoothing_value = 3
                        amplitudes_bins_min_ratio = 5
                    }
                    amplitude_cv {
                        average_num_spikes_per_bin = 50
                        percentiles                = [5, 95]
                        min_num_bins               = 10
                        amplitude_extension        = 'spike_amplitudes'
                    }
                    noise_cutoff {
                        high_quantile = 0.25
                        low_quantile  = 0.1
                        n_bins        = 100
                    }
                    sd_ratio {
                        censored_period_ms          = 4.0
                        correct_for_drift           = true
                        correct_for_template_itself = true
                    }
                    firing_range {
                        bin_size_s  = 5
                        percentiles = [5, 95]
                    }
                    nearest_neighbor {
                        max_spikes  = 10000
                        n_neighbors = 5
                    }
                    silhouette {
                        method = ['simplified']
                    }
                }
            }
        }
    }
    curation {
        job_kwargs {
            chunk_duration = '1s'
            progress_bar   = false
        }
        qc_thresholds {
            rp_contamination {
                less = 0.5
            }
            presence_ratio {
                greater = 0.8
            }
            amplitude_cutoff {
                less = 0.1
            }
        }
        unitrefine {
            noise_neural_classifier = 'SpikeInterface/UnitRefine_noise_neural_classifier'
            sua_mua_classifier      = 'SpikeInterface/UnitRefine_sua_mua_classifier'
        }
        bombcell {
            noise {
                num_positive_peaks {
                    greater = null
                    less    = 2
                }
                num_negative_peaks {
                    greater = null
                    less    = 1
                }
                peak_to_trough_duration {
                    greater = 0.0001
                    less    = 0.00115
                }
                waveform_baseline_flatness {
                    greater = null
                    less    = 0.5
                }
                peak_after_to_trough_ratio {
                    greater = null
                    less    = 0.8
                }
                exp_decay {
                    greater = 0.01
                    less    = 0.1
                }
            }
            mua {
                amplitude_median {
                    greater = 30
                    less    = null
                    abs     = true
                }
                snr {
                    greater = 5
                    less    = null
                }
                amplitude_cutoff {
                    greater = null
                    less    = 0.2
                }
                num_spikes {
                    greater = 300
                    less    = null
                }
                rp_contamination {
                    greater = null
                    less    = 0.1
                }
                presence_ratio {
                    greater = 0.7
                    less    = null
                }
                drift_ptp {
                    greater = null
                    less    = 100
                }
            }
            'non-somatic' {
                peak_before_to_trough_ratio {
                    greater = null
                    less    = 3
                }
                peak_before_width {
                    greater = 0.00015
                    less    = null
                }
                trough_width {
                    greater = 0.0002
                    less    = null
                }
                peak_before_to_peak_after_ratio {
                    greater = null
                    less    = 3
                }
                main_peak_to_trough_ratio {
                    greater = null
                    less    = 0.8
                }
            }
        }
        noise_strategy = 'bombcell+unitrefine'
        slay {
            template_similarity {
                templates_diff = 0.35
            }
            // a map, not a block: the v1 parser (Nextflow < 26.04) mis-nests a block named like its parent
            slay = [k1: 0.25, k2: 1, slay_threshold: 0.4]
        }
    }
    visualization {
        job_kwargs {
            chunk_duration = '1s'
            progress_bar   = false
        }
        timeseries {
            n_snippets_per_segment = 2
            snippet_duration_s     = 0.5
        }
        drift {
            detection {
                peak_sign        = 'neg'
                detect_threshold = 5
                exclude_sweep_ms = 0.1
            }
            localization {
                ms_before = 0.1
                ms_after  = 0.3
                radius_um = 100.0
            }
            n_skip  = 30
            alpha   = 0.15
            vmin    = -200
            vmax    = 0
            cmap    = 'Greys_r'
            figsize = [10, 10]
        }
        motion {
            cmap             = 'Greys_r'
            scatter_decimate = 15
            figsize          = [15, 10]
        }
    }
    nwb_ecephys {
        backend                             = 'zarr'
        stub                                = false
        stub_seconds                        = 10
        write_lfp                           = true
        write_raw                           = false
        lfp_temporal_factor                 = 2
        lfp_spatial_factor                  = 4
        lfp_highpass_freq_min               = 0.1
        surface_channel_agar_probes_indices = ''
        lfp {
            filter {
                freq_min = 0.1
                freq_max = 500
            }
            sampling_rate = 2500
        }
    }
    nwb_units {
        stub       = false
        stub_units = 10
    }
    spikesorting {
        sorter = null
        kilosort4 {
            job_kwargs {
                chunk_duration = '1s'
                progress_bar   = false
            }
            skip_motion_correction = false
            min_drift_channels     = 96
            raise_if_fails         = true
            clear_cache            = false
            sorter {
                batch_size                  = 60000
                nblocks                     = 5
                Th_universal                = 9
                Th_learned                  = 8
                do_CAR                      = true
                invert_sign                 = false
                nt                          = 61
                shift                       = null
                scale                       = null
                artifact_threshold          = null
                nskip                       = 25
                whitening_range             = 32
                highpass_cutoff             = 300
                binning_depth               = 5
                sig_interp                  = 20
                drift_smoothing             = [0.5, 0.5, 0.5]
                nt0min                      = null
                dmin                        = null
                dminx                       = 32
                min_template_size           = 10
                template_sizes              = 5
                nearest_chans               = 10
                nearest_templates           = 100
                max_channel_distance        = null
                templates_from_data         = true
                n_templates                 = 6
                n_pcs                       = 6
                Th_single_ch                = 6
                acg_threshold               = 0.2
                ccg_threshold               = 0.25
                cluster_downsampling        = 20
                x_centers                   = null
                duplicate_spike_ms          = 0.25
                save_preprocessed_copy      = false
                torch_device                = 'auto'
                bad_channels                = null
                clear_cache                 = false
                save_extra_vars             = false
                do_correction               = true
                keep_good_only              = false
                skip_kilosort_preprocessing = false
                use_binary_file             = null
                delete_recording_dat        = true
            }
        }
        kilosort25 {
            job_kwargs {
                chunk_duration = '1s'
                progress_bar   = false
            }
            skip_motion_correction = false
            min_drift_channels     = 96
            raise_if_fails         = true
            sorter {
                detect_threshold            = 6
                projection_threshold        = [10, 4]
                preclust_threshold          = 8
                car                         = true
                minFR                       = 0.1
                minfr_goodchannels          = 0.1
                nblocks                     = 5
                sig                         = 20
                freq_min                    = 150
                sigmaMask                   = 30
                nPCs                        = 3
                ntbuff                      = 64
                nfilt_factor                = 4
                NT                          = null
                AUCsplit                    = 0.9
                do_correction               = true
                wave_length                 = 61
                keep_good_only              = false
                skip_kilosort_preprocessing = false
                scaleproc                   = null
                save_rez_to_mat             = false
                delete_tmp_files            = ['matlab_files']
                delete_recording_dat        = false
            }
        }
        spykingcircus2 {
            job_kwargs {
                chunk_duration = '1s'
                progress_bar   = false
            }
            sorter {
                general {
                    ms_before = 0.5
                    ms_after  = 1.5
                    radius_um = 100.0
                }
                filtering {
                    freq_min     = 150
                    freq_max     = 7000
                    ftype        = 'bessel'
                    filter_order = 2
                }
                whitening {
                    mode       = 'local'
                    regularize = false
                }
                detection {
                    method          = 'matched_filtering'
                    method_kwargs {
                        peak_sign        = 'neg'
                        detect_threshold = 5
                    }
                    pipeline_kwargs = [:]
                }
                selection {
                    method = 'uniform'
                    method_kwargs {
                        n_peaks_per_channel = 5000
                        min_n_peaks         = 100000
                        select_per_channel  = false
                    }
                }
                apply_motion_correction       = true
                motion_correction {
                    preset = 'dredge_fast'
                }
                merging {
                    max_distance_um = 50
                }
                clustering {
                    method        = 'iterative-hdbscan'
                    method_kwargs = [:]
                }
                cleaning {
                    min_snr                 = 5
                    max_jitter_ms           = 0.2
                    sparsify_threshold      = 1
                    mean_sd_ratio_threshold = 3
                }
                min_firing_rate               = 0.1
                matching {
                    method          = 'circus-omp'
                    method_kwargs   = [:]
                    pipeline_kwargs = [:]
                }
                apply_preprocessing           = false
                apply_whitening               = true
                cache_preprocessing {
                    mode = 'no-cache'
                }
                chunk_preprocessing {
                    memory_limit = null
                }
                multi_units_only              = false
                job_kwargs                    = [:]
                seed                          = 42
                deterministic_peaks_detection = false
                debug                         = false
            }
        }
        lupin {
            job_kwargs {
                chunk_duration = '1s'
                progress_bar   = false
            }
            sorter {
                apply_preprocessing          = true
                preprocessing_dict           = [:]
                apply_motion_correction      = true
                motion_correction_preset     = 'dredge_fast'
                clustering_ms_before         = 0.3
                clustering_ms_after          = 1.3
                whitening_radius_um          = 100.0
                detection_radius_um          = 50.0
                features_radius_um           = 120.0
                split_radius_um              = 60.0
                template_radius_um           = 100.0
                freq_min                     = 150.0
                freq_max                     = 7000.0
                cache_preprocessing_mode     = 'no-cache'
                peak_sign                    = 'neg'
                detect_threshold             = 5.0
                n_peaks_per_channel          = 5000
                n_svd_components_per_channel = 5
                n_pca_features               = 4
                clustering_recursive_depth   = 3
                ms_before                    = 1.0
                ms_after                     = 2.5
                template_sparsify_threshold  = 1.5
                template_min_snr_ptp         = 4.0
                template_max_jitter_ms       = 0.2
                template_matching_engine     = 'circus-omp'
                min_firing_rate              = 0.1
                gather_mode                  = 'memory'
                job_kwargs                   = [:]
                seed                         = null
                save_array                   = true
                debug                        = false
            }
        }
        dartsort {
            job_kwargs {
                chunk_duration = '1s'
                progress_bar   = false
            }
            sorter {
                do_motion_estimation           = true
                already_preprocessed           = 'assume_yes_if_float'
                preprocessing                  = 'standardize'
                preprocessing_dtype            = 'float32'
                subsampling_spikes_per_channel = 5000
                subsampling_presence           = 0.025
                matching_iterations            = 1
                dredge_only                    = false
                n_jobs_cpu                     = 0
                n_jobs_gpu                     = 0
                motion_n_jobs_gpu              = 2
                n_jobs_small                   = -2
                n_jobs_small_gpu               = 4
                device                         = null
                executor                       = 'threading_unless_multigpu'
                chunk_length_samples           = 30000
                work_in_tmpdir                 = true
                copy_recording_to_tmpdir       = 'no'
                workdir_copier                 = 'shutil'
                workdir_follow_symlinks        = false
                tmpdir_parent                  = 'scratch'   // task-local (Code Ocean used ../scratch from capsule/code)
                save_intermediates             = false
                save_final_features            = true
                ms_before                      = 1.4
                ms_after                       = 2.6333333333333333
                alignment_ms                   = 1.5
                deduplication_ms               = 0.25
                peak_sign                      = 'both'
                voltage_threshold              = 3.0
                matching_threshold             = 6.0
                initial_threshold              = 9.0
                motion_voltage_threshold       = 4.0
                temporal_pca_rank              = 8
                feature_ms_before              = 0.75
                feature_ms_after               = 1.25
                subtraction_radius_um          = 200.0
                deduplication_radius_um        = 50.0
                featurization_radius_um        = 150.0
                fit_radius_um                  = 75.0
                localization_radius_um         = 100.0
                nn_denoiser_class_name         = 'Decollider'
                nn_denoiser_pretrained_path    = null
                amplitude_scaling_stddev       = 0.01
                amplitude_scaling_boundary     = 0.3333333333333333
                temporal_upsamples             = 4
                postprocessing                 = 'agglomerate_and_clean'
                rigid                          = false
                probe_boundary_padding_um      = 100.0
                spatial_bin_length_um          = 1.0
                temporal_bin_length_s          = 1.0
                smoothing_um                   = 3.0
                smoothing_s                    = null
                window_step_um                 = 400.0
                window_scale_um                = 600.0
                window_margin_um               = null
                max_dt_s                       = 500.0
                max_disp_um                    = null
                correlation_threshold          = 0.1
                min_amplitude                  = null
                speed_limit_um_per_s           = 500.0
                max_dist_from_median_um        = 250.0
                median_neighborhood_bins       = 51
                motion_batching_mode           = 'full'
                motion_chunk_len_s             = 3000.0
                fit_matching_models_only       = false
                save_full_final_residual       = false
            }
        }
    }
    results_collector {
        pipeline_data_path    = null
        pipeline_results_path = null
    }
    quality_control {
        pipeline_data_path = null
    }
}

// Compute resources -- one label per process (process_cpu | process_gpu), sizes, retries, caps
includeConfig 'conf/base.config'

// step scripts print their progress as they go (as `python -u` did)
env.PYTHONUNBUFFERED = '1'

/*
 * CONTAINERS -- the image of every process, in one place (Dockerfiles: modules/local/<tool>/).
 * Tag: --container_tag, else the CONTAINER_TAG environment variable, else the pipeline version (manifest.version).
 */
process {
    withName: 'EPHYS_.*|SPYKINGCIRCUS2_SPIKESORT|LUPIN_SPIKESORT' {
        container = { "ghcr.io/allenneuraldynamics/aind-ephys-pipeline-base:${params.container_tag ?: workflow.manifest.version}" }
    }
    withName: 'KILOSORT25_SPIKESORT' {
        container = { "ghcr.io/allenneuraldynamics/aind-ephys-spikesort-kilosort25:${params.container_tag ?: workflow.manifest.version}" }
    }
    withName: 'KILOSORT4_SPIKESORT' {
        container = { "ghcr.io/allenneuraldynamics/aind-ephys-spikesort-kilosort4:${params.container_tag ?: workflow.manifest.version}" }
    }
    withName: 'DARTSORT_SPIKESORT' {
        container = { "ghcr.io/allenneuraldynamics/aind-ephys-spikesort-dartsort:${params.container_tag ?: workflow.manifest.version}" }
    }
    withName: 'NWB_.*' {
        container = { "ghcr.io/allenneuraldynamics/aind-ephys-pipeline-nwb:${params.container_tag ?: workflow.manifest.version}" }
    }
}

/*
 * PROCESS -- per-process settings. Every step runs its script, bin/<step>.py, from the task
 * directory; `extra_installs` applies to the steps that installed extras before.
 */
process {
    ext.n_jobs        = { params.n_jobs }

    withName: 'EPHYS_JOBDISPATCH' {
        ext.extra_installs = { params.extra_installs }
    }
    withName: 'EPHYS_PREPROCESSING' {
        ext.extra_installs = { params.extra_installs }
    }
    withName: 'EPHYS_POSTPROCESSING' {
        ext.extra_installs = { params.extra_installs }
    }
    withName: 'EPHYS_VISUALIZATION' {
        ext.extra_installs = { params.extra_installs }
    }
    withName: 'EPHYS_RESULTSCOLLECTOR' {
        ext.extra_installs = { params.extra_installs }
    }
    withName: 'EPHYS_QUALITYCONTROL' {
        ext.extra_installs = { params.extra_installs }
    }
    withName: 'NWB_ECEPHYS' {
        ext.extra_installs = { params.extra_installs }
    }
    withName: 'NWB_UNITS' {
        ext.extra_installs = { params.extra_installs }
    }
    // the sorters, EPHYS_CURATION, EPHYS_QCCOLLECTOR and EPHYS_PROVENANCE have no per-process settings
}

/*
 * CONTAINER RUNTIMES -- enabled by the matching profile
 */
docker {
    enabled      = false
    runOptions   = '--platform=linux/amd64 --memory-swap=-1 --memory-swappiness 20 --shm-size=4g'
    envWhitelist = ['FIGPACK_API_KEY', 'FIGPACK_UPLOAD', 'FIGPACK_BUCKET']
}
apptainer {
    enabled      = false
    autoMounts   = true
    envWhitelist = ['FIGPACK_API_KEY', 'FIGPACK_UPLOAD', 'FIGPACK_BUCKET', 'NUMBA_CACHE_DIR', 'HDF5_USE_FILE_LOCKING']
}
singularity {
    enabled      = false
    autoMounts   = true
    envWhitelist = ['FIGPACK_API_KEY', 'FIGPACK_UPLOAD', 'FIGPACK_BUCKET', 'NUMBA_CACHE_DIR', 'HDF5_USE_FILE_LOCKING']
}

profiles {
    // local machine with Docker (reads public S3 data anonymously)
    docker {
        docker.enabled       = true
        aws.client.anonymous = true
        process.debug        = true
    }
    // Apptainer / Singularity
    apptainer {
        apptainer.enabled     = true
        env.PYTHONNOUSERSITE  = 1    // don't use user site-packages
        process.debug         = true
    }
    singularity {
        singularity.enabled   = true
        env.PYTHONNOUSERSITE  = 1
        process.debug         = true
    }
}
