plugins {
    id 'nf-schema@2.7.3' // validates the parameters file; needs Nextflow >= 25.10
}

process { 
  executor = 'awsbatch' 
  queueSize = 100

  resourceLabels = ['allen-batch-pipeline': 'aind-ephys-pipeline']

  withName: save_provenance {
    cpus = 1
    memory = '2 GB'
  }
  withName: job_dispatch {
    cpus = 4
    memory = '32 GB'
  }
  withName: preprocessing {
    cpus = 16
    memory = '64 GB'
  }
  withName: spikesort_kilosort4 {
    cpus = 16
    memory = '60 GB'
    accelerator = 1
  }
  withName: spikesort_kilosort25 {
    cpus = 16
    memory = '60 GB'
    accelerator = 1
  }
  withName: spikesort_spykingcircus2 {
    cpus = 16
    memory = '64 GB'
    containerOptions = '--memory-swappiness 20 --shm-size 16g'
  }
  withName: spikesort_lupin {
    cpus = 16
    memory = '64 GB'
    containerOptions = '--memory-swappiness 20 --shm-size 16g'
  }
  withName: spikesort_dartsort {
    cpus = 16
    memory = '60 GB'
    accelerator = 1
  }
  withName: postprocessing { 
    cpus = 16
    memory = '64 GB'
    containerOptions = '--memory-swappiness 20 --shm-size 16g' 
  }
  withName: curation { 
    cpus = 4
    memory = '32 GB'
  }
  withName: visualization { 
    cpus = 4
    memory = '32 GB'
  }
  withName: results_collector {
    cpus = 4
    memory = '32 GB'
  }
  withName: quality_control {
    cpus = 8
    memory = '64 GB'
    containerOptions = '--memory-swappiness 20 --shm-size 16g'
  }
  withName: quality_control_collector {
    cpus = 1
    memory = '8 GB'
  }
  withName: nwb_ecephys { 
    cpus = 8
    memory = '64 GB'
  }
  withName: nwb_units { 
    cpus = 4
    memory = '32 GB'
  }
}

// Env variables for the pipeline
env.DATA_PATH = 's3://aind-ephys-data/ecephys_713593_2024-02-08_14-10-37'
params.params_file = 'params_co.json'
// Don't pass the per-run RESULTS_PATH to the results collector, so it can be cached
params.pass_pipeline_paths = false
// params.container_tag = '1.5.0-dev'
env.SORTER = 'kilosort4'
env.FIGPACK_API_KEY    = System.getenv('FIGPACK_API_KEY')    ?: ''
env.FIGPACK_BUCKET = 'aind-figpack-client'
env.FIGPACK_UPLOAD = '1'


docker {
  envWhitelist = ['FIGPACK_API_KEY', 'FIGPACK_BUCKET', 'FIGPACK_UPLOAD']
}
