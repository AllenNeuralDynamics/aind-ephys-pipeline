process { 
    executor = 'awsbatch' 
    queueSize = 100
}

process.resourceLabels = ['allen-batch-pipeline': 'aind-ephys-pipeline-kilosort4']

// --shm-size needs its unit: Nextflow 25 reads a bare number as bytes, while 22.10 passed it to AWS Batch as MiB
process {
  withName: capsule_aind_ephys_postprocessing_5 {
    containerOptions = '--memory-swap 240000 --memory-swappiness 20 --shm-size 16000000m'
  }
  withName: capsule_spikesort_kilosort_4_ecephys_7 {
    errorStrategy = 'retry'
    maxRetries = 3
    maxErrors = 5
  }
  withName: capsule_quality_control_ecephys_13 { 
    containerOptions = '--memory-swap 240000 --memory-swappiness 20 --shm-size 16000000m'
    errorStrategy = 'ignore'
  }
}

env.PIPELINE_URL = "https://github.com/AllenNeuralDynamics/aind-ephys-pipeline"
env.PIPELINE_VERSION = "kilosort4_1.0.0"