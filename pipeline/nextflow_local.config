nextflow.enable.strict = false

params.executor = "local"

// extra pip packages (comma-separated) installed before running each process, e.g. "mtscomp==1.0.2,other_pkg"
params.extra_installs = ""

plugins {
    id 'nf-schema@2.7.3' // validates the parameters file; needs Nextflow >= 25.10
}

process {
    executor = 'local'
    debug = true
    cpus = 8
    memory = '32 GB'
	containerOptions = '--memory-swap=-1 --memory-swappiness 20 --shm-size=4g'

    // change max forks for specific processes to allow multiple forks
    withName: preprocessing {
        maxForks = 1
    }
    withName: spikesort_kilosort4 {
        maxForks = 1
        containerOptions = '--gpus all'
    }
    withName: spikesort_kilosort25 {
        maxForks = 1
        containerOptions = '--gpus all'
    }
    withName: spikesort_dartsort {
        maxForks = 1
        containerOptions = '--gpus all'
    }
    withName: spikesort_spykingcircus2 {
        maxForks = 1
    }
    withName: spikesort_lupin {
        maxForks = 1
    }
    withName: postprocessing {
        maxForks = 1
    }
    withName: quality_control {
        maxForks = 1
    }
}

docker {
    enabled = true
    platform = 'linux/amd64'
    runOptions = '--volume $DATA_PATH:/tmp/data'
    envWhitelist = ['FIGPACK_API_KEY', 'FIGPACK_UPLOAD', 'FIGPACK_BUCKET']
}

dag {
    enabled = true
    file = env('RESULTS_PATH') + '/nextflow/dag.html'
    overwrite = true
}

report {
    enabled = true
    file = env('RESULTS_PATH') + '/nextflow/report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = env('RESULTS_PATH') + '/nextflow/timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = env('RESULTS_PATH') + '/nextflow/trace.txt'
    overwrite = true
}
